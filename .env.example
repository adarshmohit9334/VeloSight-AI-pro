# =======================================================
# VELOSIGHT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================

# Database Settings (PostgreSQL or H2 Embedded Fallback)
DATABASE_URL=jdbc:postgresql://localhost:5432/velosight_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DRIVER=org.postgresql.Driver

# Backend Server & JWT Configuration
SERVER_PORT=8080
JWT_SECRET=VeloSightSuperSecretKeyForJWTAuthTokenGeneration2026SecureKey!
JWT_EXPIRATION_MS=86400000

# AI Computer Vision Microservice Configuration
AI_SERVICE_URL=http://localhost:8000
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
FRAME_SKIP_RATE=2

# Storage Directories
UPLOAD_DIRECTORY=uploads
PROCESSED_DIRECTORY=processed
